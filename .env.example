# Copy this file to .env.local and fill in your keys.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server and are never sent to the browser.

# --- Supabase (required for auth and data) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Server only — required for POST /api/health/webhook (HC Webhook app has no login cookies).
# NEVER expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Gemini AI (assistant, nutrition AI, image/video analysis) — server only ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated fallback order of models
# GEMINI_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.5-flash-lite

# --- Optional integrations (the app uses built-in fallbacks without them) — server only ---
# NewsAPI (health articles) — https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# --- Fitbit Web API (wearable data) ---
# Register your app at: https://dev.fitbit.com/apps/new
FITBIT_CLIENT_ID=your_fitbit_client_id_here
FITBIT_CLIENT_SECRET=your_fitbit_client_secret_here
NEXT_PUBLIC_FITBIT_CLIENT_ID=your_fitbit_client_id_here
